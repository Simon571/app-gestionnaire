# Fichier .env.example
# Copiez ce fichier en .env.local et remplissez les valeurs

# URL de base de l'application (à modifier après déploiement Vercel)
NEXT_PUBLIC_BASE_URL=https://votre-domaine.vercel.app

# URL GitHub Releases (à modifier avec votre username)
NEXT_PUBLIC_GITHUB_RELEASES_URL=https://github.com/VOTRE-USERNAME/app-gestionnaire/releases/latest

# Téléchargement Windows - URL du fichier MSI
# Par défaut redirige vers le dernier release GitHub
NEXT_PUBLIC_WINDOWS_DOWNLOAD_URL=https://github.com/Simon571/app-gestionnaire/releases/latest/download/Gestionnaire-setup.msi

# Métadonnées du téléchargement (optionnel, pour affichage)
# NEXT_PUBLIC_WINDOWS_DOWNLOAD_SIZE=150 MB
# NEXT_PUBLIC_WINDOWS_DOWNLOAD_SHA256=abc123...
# NEXT_PUBLIC_WINDOWS_SIGNED=false

# Analytics (optionnel)
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Supabase (si utilisé)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Firebase (si utilisé)
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# ---------------------------------------------------------------------------
# Sécurité de l'API (obligatoire en production)
# ---------------------------------------------------------------------------

# Secret de signature du cookie de session. 32 caractères minimum.
# Sans lui, la connexion renvoie 503 : aucune session ne peut être signée.
# Générer :  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ---------------------------------------------------------------------------
# Super admin de la plateforme (obligatoire pour gérer les abonnements)
# ---------------------------------------------------------------------------

# Compte unique qui administre toutes les assemblées et leurs abonnements.
# Générer le hash :  npx tsx scripts/hash-password.ts
# Le mot de passe en clair n'est jamais stocké, ni côté serveur ni ici.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD_HASH=

# Identifiants administrateur de l'assemblée.
# ATTENTION : depuis le passage en multi-assemblées, ces variables ne servent
# plus qu'à AMORCER le registre (data/platform/assemblies.json) au premier
# démarrage, quand il est encore vide. Ensuite, les assemblées et leurs PIN sont
# gérés depuis /super-admin. Sans ces variables, l'amorçage retombe sur les
# identifiants historiques, publiés dans l'ancien bundle client : régénérer le
# PIN depuis la console dès la première connexion.
ASSEMBLY_ID=
ASSEMBLY_PIN=
ASSEMBLY_NAME=

# Mode d'application de l'authentification API :
#   report  (défaut) : les requêtes non authentifiées passent et sont signalées
#                      dans les logs et par l'en-tête X-Auth-Warning
#   enforce          : elles sont rejetées avec un 401
# Rester en 'report' le temps de publier des clients MSI/APK qui
# s'authentifient, puis basculer sur 'enforce'.
API_AUTH_MODE=report

# Jeton partagé pour les clients machine (MSI, scripts d'import), envoyé dans
# l'en-tête x-api-token. 16 caractères minimum, sinon il est ignoré.
API_ACCESS_TOKEN=

# Origines autorisées en plus du site et du MSI Tauri, séparées par des
# virgules. Les domaines *.vercel.app sont déjà acceptés.
# ALLOWED_ORIGINS=https://assemblee.example

# Redis Upstash : stockage persistant des données ET compteurs de rate limiting
# partagés entre instances. Sans lui, le rate limiting reste local au processus
# et n'offre aucune protection réelle en serverless.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Secret d'import VCM utilisé par scripts/import-vcm.ts
VCM_IMPORT_SECRET=

# Mise à jour continue du cahier « Vie chrétienne et ministère ».
# L'extraction (npm run vcm:update:all) tourne sur un vrai runtime Node — action
# planifiée GitHub ou poste de travail — puis `npm run vcm:publish` dépose le
# résultat dans l'application via POST /api/vcm/program, sans redéploiement.
# VCM_PUBLISH_URL  : URL de base de l'application visée (défaut http://localhost:3000)
# Le dépôt s'authentifie avec API_ACCESS_TOKEN (ci-dessus), envoyé en x-api-token.
VCM_PUBLISH_URL=

# Clé de l'ancienne route /api/update-workbook, conservée pour les scripts
# existants. 16 caractères minimum, sinon elle est ignorée et seuls le super
# admin et API_ACCESS_TOKEN peuvent déposer un programme.
AUTOMATION_API_KEY=

# Identité mobile partagée `mobile-main`, embarquée dans l'APK publié. Elle
# n'identifie pas un téléphone mais « un client mobile officiel » : une seule clé
# pour tous les appareils. Elle reste active pour ne pas couper les installations
# existantes.
#   PUBLISHER_BOOTSTRAP_TENANT  : assemblée à laquelle la rattacher. Sans valeur,
#                                 elle lit le jeu de données historique non préfixé.
#   PUBLISHER_BOOTSTRAP_DEVICE=off : la désactive, à faire dès qu'un APK utilisant
#                                 des clés par appareil (npm run sync:keys) est publié.
PUBLISHER_BOOTSTRAP_TENANT=
# PUBLISHER_BOOTSTRAP_DEVICE=off

# Clé Google AI (Genkit)
GEMINI_API_KEY=
