# ---------------------------------------------------------------------------
# Configuration du serveur propre (VPS)
#
#   cp .env.server.example .env
#   nano .env                       (remplir les valeurs)
#   docker compose up -d --build
#
# Ce fichier est lu a la fois par docker-compose (pour ${DOMAIN}, la base) et par
# l'application elle-meme. Il contient des secrets : il ne doit jamais etre
# ajoute a git. Sur le serveur :  chmod 600 .env
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# 1. Adresse publique   (les deux seules lignes indispensables au demarrage)
# ---------------------------------------------------------------------------

# Nom de domaine, sans https:// ni barre oblique. Il doit deja pointer vers
# l'adresse IP du serveur : le certificat HTTPS est valide a travers lui.
# Une adresse IP nue ne convient pas — aucun certificat n'est delivre pour une
# IP, et l'application Android refuse une connexion sans HTTPS.
DOMAIN=assemblee.exemple.org

# Adresse a laquelle Let's Encrypt previent d'un certificat proche d'expirer.
ADMIN_EMAIL=vous@exemple.org

# ---------------------------------------------------------------------------
# 2. Base de donnees
# ---------------------------------------------------------------------------

# Elle n'est accessible que depuis l'interieur du reseau Docker, mais un mot de
# passe long reste la bonne habitude :
#   openssl rand -base64 24
POSTGRES_USER=gestionnaire
POSTGRES_PASSWORD=
POSTGRES_DB=gestionnaire

# ---------------------------------------------------------------------------
# 3. Securite   (obligatoire : sans SESSION_SECRET, aucune connexion possible)
# ---------------------------------------------------------------------------

# Signature du cookie de session. 32 caracteres minimum. A generer sur le
# serveur, et a ne jamais changer ensuite sans deconnecter tout le monde :
#   openssl rand -hex 32
SESSION_SECRET=

# Compte qui administre toutes les assemblees et leurs abonnements.
# Le mot de passe n'est jamais stocke : seule son empreinte l'est.
#   npm run hash:password
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD_HASH=

# Premiere assemblee, creee automatiquement au premier demarrage quand le
# registre est encore vide. Ensuite tout se gere depuis /super-admin.
# Sans ces valeurs, l'amorcage retombe sur le PIN historique, qui a ete publie
# dans l'ancien code du navigateur : le regenerer aussitot depuis la console.
ASSEMBLY_ID=
ASSEMBLY_PIN=
ASSEMBLY_NAME=

# Jeton des clients machine (installateur Windows, scripts d'import), envoye
# dans l'en-tete x-api-token. 16 caracteres minimum.
#   openssl rand -hex 24
API_ACCESS_TOKEN=

# report  : les requetes non authentifiees passent et sont signalees
# enforce : elles sont refusees
# Rester en 'report' jusqu'a ce que le nouvel APK et le nouveau MSI soient
# installes partout, puis basculer.
API_AUTH_MODE=report

# ---------------------------------------------------------------------------
# 4. Optionnel
# ---------------------------------------------------------------------------

# Assistant et synthese vocale (Google AI). Sans cette cle, ces deux
# fonctions repondent une erreur ; le reste de l'application fonctionne.
GEMINI_API_KEY=

# Secret d'import du cahier VCM (scripts/import-vcm.ts).
VCM_IMPORT_SECRET=

# Adresse visee par `npm run vcm:publish`. Sur serveur propre :
# VCM_PUBLISH_URL=https://assemblee.exemple.org

# ---------------------------------------------------------------------------
# 5. Volontairement absent
# ---------------------------------------------------------------------------
#
# Ni VERCEL, ni UPSTASH_REDIS_REST_URL, ni UPSTASH_REDIS_REST_TOKEN, ni
# BLOB_READ_WRITE_TOKEN.
#
# C'est leur absence qui fait ecrire les donnees dans des fichiers du dossier
# ./data du serveur, au lieu de Redis et de Vercel Blob. Plus de quota mensuel,
# plus de service exterieur a payer ou a surveiller — et c'est ce dossier ./data
# que la sauvegarde (deploy/sauvegarde.sh) copie chaque nuit.
