# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/.next-tauri/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
# ATTENTION: tout fichier d'environnement contenant des valeurs reelles doit
# etre ignore ici. Seuls les *.example sont versionnes.
.env
.env.*
!.env.example
!.env.local.example
!.env.server.example

# vercel
.vercel

# genkit
.genkit/cache

# Tauri
/src-tauri/target
/src-tauri/WixTools
# Artefacts de build Next embarques dans le bundle Tauri (regeneres par
# `npm run build:tauri` + scripts/copy-next-static.js)
/src-tauri/resources/.next/
/src-tauri/next-dist.tar.gz

# Build artifacts
*.msi
*.exe
*.app
*.dmg
*.deb
*.AppImage

# Dossiers de test temporaires
/tmp-*/

# Logs de build (MSI, Tauri, Flutter). Aucun log ne doit etre versionne : ils
# pesent jusqu'a 160 Ko chacun et ne decrivent qu'une machine a un instant.
*.log

# Caches et binaires locaux
*.tsbuildinfo
node.exe

# IDE
/.idea/
*.iml
/.vscode/

# Donnees d'assemblee reelles (noms de proclamateurs, base de sync SQLite).
# Ce sont des donnees personnelles : elles n'ont rien a faire dans un depot
# GitHub. En local (dev / MSI Tauri) les stores recreent les fichiers a la
# demande ; sur Vercel la persistance passe par Upstash Redis
# (voir src/lib/blob-store.ts), donc rien ne depend de ces fichiers au build.
/data/
# Exception : registre d'amorcage des appareils, requis par les routes API et
# deja declare comme tel dans .vercelignore.
!/data/publisher-sync/
/data/publisher-sync/*
!/data/publisher-sync/devices.json

# Liste nominative de proclamateurs exportee en local : donnees personnelles.
/LISTE DES PROCLAMATEURS.txt
.secrets-bootstrap.json
.secrets-bootstrap.env

# Artefacts locaux et donnees d'appareil (vraies donnees personnelles) : rien
# de tout cela ne doit finir sur GitHub. `export/` reste versionne (images du
# programme), donc on ignore uniquement les fichiers d'export nominatifs.
/releases/
people-export.json
export/*.jwpub

# Donnees personnelles et identifiants de l'appareil Flutter : jamais sur GitHub.
flutter_app/config/local_users.json
flutter_app/config/sync_credentials.json
flutter_app/config/local_assembly.json
flutter_app/assets/data/local_users.json

# Artefact TypeScript de suivi (regenerable, deja ignore par *.tsbuildinfo).
tsconfig.tsbuildinfo
