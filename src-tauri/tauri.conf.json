{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Gestionnaire d'Assemblée",
  "version": "1.0.4",
  "identifier": "com.appgestionnaire.app",
  "build": {
    "beforeDevCommand": "npm run dev:tauri",
    "beforeBuildCommand": "powershell -File build-tauri-final.ps1"
  },
  "app": {
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/**/*"
    ]
  },
  "plugins": {
    "process": {
      "sidecar": true
    }
  }
}
